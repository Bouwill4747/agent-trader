# Polymarket (derived from wallet — run: python setup_wallet.py)
POLYGON_PRIVATE_KEY=REPLACE_WITH_YOUR_PRIVATE_KEY

# CLOB API credentials are auto-derived from your wallet private key.
# Only set these if you have pre-derived credentials from setup_wallet.py:
# POLYMARKET_API_KEY=
# POLYMARKET_API_SECRET=
# POLYMARKET_API_PASSPHRASE=

# Claude LLM (get from console.anthropic.com)
ANTHROPIC_API_KEY=REPLACE_WITH_YOUR_ANTHROPIC_KEY

# News data (get from newsapi.org — free tier: 1000 req/day)
NEWS_API_KEY=REPLACE_WITH_YOUR_NEWSAPI_KEY

# Macroeconomic data (get from https://fredaccount.stlouisfed.org/apikey — free)
FRED_API_KEY=REPLACE_WITH_YOUR_FRED_KEY

# Economic calendar (get from https://finnhub.io/register — free tier)
FINNHUB_API_KEY=REPLACE_WITH_YOUR_FINNHUB_KEY

# Agent settings
PAPER_TRADING=true
INITIAL_BANKROLL=100

# Optional: override the Claude model used for market analysis
# LLM_MODEL=claude-sonnet-4-5-20250929
