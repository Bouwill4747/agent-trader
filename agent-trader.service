[Unit]
Description=Polymarket Trading Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=will
WorkingDirectory=/home/will/agent_trader
ExecStart=/home/will/agent_trader/venv/bin/python3 main.py
Restart=on-failure
RestartSec=30
StandardOutput=append:/home/will/agent_trader/data/agent.log
StandardError=append:/home/will/agent_trader/data/agent.log

[Install]
WantedBy=multi-user.target
